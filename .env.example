# =========================================================
# SHTOR HOUSE — Environment Variables Example
# Bu faylni .env ga nusxalang va qiymatlarni o'zgartiring
# =========================================================

# Django core:
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-super-secret-key-min-50-chars-random
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Google OAuth (Google Cloud Console dan oling):
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/

# AI maslahatchi (Google AI Studio'dan bepul kalit oling):
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
# Yoki OpenAI:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Email (production uchun):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=SHTOR HOUSE <no-reply@example.com>

# Production security (production da True qiling):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True